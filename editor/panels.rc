#include <windows.h>
#include <commctrl.h>
#include "panel_ids.h"

#ifdef BSC_EMBED_MANIFEST
1 RT_MANIFEST "editor.manifest"
#endif

IDD_TOOLBAR DIALOGEX 0, 0, 300, TOOLBAR_HEIGHT
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "World space", IDC_TRANSFORM_SPACE, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 0, 1, 21, 23
    LTEXT "Camera speed", IDC_SPEED_LABEL, 4, 7, 54, 12
    CONTROL "", IDC_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_NOTICKS, 62, 3, 140, 19
    LTEXT "", IDC_SPEED_VALUE, 210, 7, 55, 12
END

IDD_BROWSER DIALOGEX 0, 0, BROWSER_WIDTH, 240
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Content browser", -1, 7, 8, 79, 14
    PUSHBUTTON "Refresh", IDC_REFRESH, 95, 5, 42, 15
    CONTROL "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 7, 25, 130, 64
    LTEXT "", IDC_PREVIEW_STATUS, 7, 93, 130, 13
    LTEXT "assets/models", IDC_MODEL_ROOT, 7, 109, 130, 13
    CONTROL "", IDC_MODELS, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, 124, 130, 109
END

IDD_ROAD DIALOGEX 0, 0, ROAD_PANEL_WIDTH, ROAD_PANEL_HEIGHT
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Road editor", IDC_ROAD_TITLE, 7, 7, 136, 12
    PUSHBUTTON "Top-down view  [R]", IDC_VIEW, 7, 24, 136, 16
    PUSHBUTTON "New road", IDC_NEW, 7, 44, 136, 16
    LTEXT "Alignment", -1, 7, 70, 51, 12
    COMBOBOX IDC_ALIGNMENT, 63, 66, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Lanes", -1, 7, 91, 50, 12
    PUSHBUTTON "-", IDC_FEWER, 63, 87, 22, 16
    CTEXT "", IDC_LANE_COUNT, 88, 91, 27, 12
    PUSHBUTTON "+", IDC_MORE, 121, 87, 22, 16
    LTEXT "3-lane layout", IDC_LAYOUT_LABEL, 7, 112, 55, 12
    COMBOBOX IDC_LAYOUT, 63, 108, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_LANE_DETAIL, 7, 112, 136, 12
    LTEXT "Shoulders (5 m each)", -1, 7, 130, 136, 12
    AUTOCHECKBOX "Left", IDC_LEFT, 7, 145, 60, 11
    AUTOCHECKBOX "Right", IDC_RIGHT, 77, 145, 60, 11
    LTEXT "Road edges", -1, 7, 168, 53, 12
    COMBOBOX IDC_EDGE, 63, 164, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_WIDTH, 7, 185, 136, 12
    LTEXT "", IDC_POINT, 7, 199, 136, 12
    PUSHBUTTON "Finish road", IDC_FINISH, 7, 199, 66, 16
    PUSHBUTTON "Cancel draft", IDC_CANCEL_DRAFT, 77, 199, 66, 16
    PUSHBUTTON "Delete selected road", IDC_REMOVE, 7, 219, 136, 16
END
