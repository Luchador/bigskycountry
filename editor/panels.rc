#include <windows.h>
#include <commctrl.h>
#include "panel_ids.h"

#ifdef BSC_EMBED_MANIFEST
1 RT_MANIFEST "editor.manifest"
#endif

IDD_TOOLBAR DIALOGEX 0, 0, 300, TOOLBAR_HEIGHT
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    RTEXT "1 m", IDC_SNAP_STEP, 0, 7, 34, 12
    CONTROL "Snap off", IDC_SNAP_TO_GRID, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 38, 1, 21, 23
    CONTROL "World space", IDC_TRANSFORM_SPACE, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 0, 1, 21, 23
    LTEXT "Camera speed", IDC_SPEED_LABEL, 4, 7, 54, 12
    CONTROL "", IDC_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_NOTICKS, 62, 3, 140, 19
    LTEXT "", IDC_SPEED_VALUE, 210, 7, 55, 12
END

IDD_BROWSER DIALOGEX 0, 0, BROWSER_WIDTH, 240
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Content browser", -1, 7, 8, 79, 14
    PUSHBUTTON "Refresh", IDC_REFRESH, 95, 5, 42, 15
    CONTROL "", IDC_BROWSER_TABS, "SysTabControl32", WS_TABSTOP | TCS_FOCUSONBUTTONDOWN, 7, 24, 130, 21
    CONTROL "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 7, BROWSER_PAGE_TOP, 130, 64
    LTEXT "", IDC_PREVIEW_STATUS, 7, 116, 130, 13
    CONTROL "", IDC_MODELS, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, BROWSER_MODEL_LIST_TOP, 130, 101
    CONTROL "", IDC_TEXTURE_FOLDERS, "SysTreeView32", NOT WS_VISIBLE | WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, BROWSER_PAGE_TOP, 130, 64
    LTEXT "", IDC_TEXTURE_STATUS, 7, BROWSER_PAGE_TOP, 130, 13, NOT WS_VISIBLE
    CONTROL "", IDC_TEXTURES, "ListBox", NOT WS_VISIBLE | WS_TABSTOP | WS_BORDER | WS_VSCROLL | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT, 7, BROWSER_PAGE_TOP, 130, 185
END

IDD_ROAD DIALOGEX 0, 0, ROAD_PANEL_WIDTH, ROAD_PANEL_HEIGHT
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX "Use Geographic Coordinates", IDC_USE_GEOGRAPHIC, 7, 1, 186, 12, WS_TABSTOP
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 7, 81, 191, 1
    CTEXT "X", IDC_AXIS_X, 64, 14, 41, 9
    CTEXT "Y", IDC_AXIS_Y, 108, 14, 41, 9
    CTEXT "Z", IDC_AXIS_Z, 152, 14, 41, 9
    LTEXT "Latitude, longitude", IDC_COORDINATES_LABEL, 7, 14, 124, 9, NOT WS_VISIBLE
    LTEXT "Elevation (m)", IDC_ELEVATION_LABEL, 138, 14, 55, 9, NOT WS_VISIBLE
    EDITTEXT IDC_GEO_LOCATION, 7, 24, 126, 14, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT "Location (m)", IDC_POSITION_LABEL, 7, 27, 54, 12
    EDITTEXT IDC_LOC_X, 64, 24, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_LOC_Y, 108, 24, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_LOC_Z, 152, 24, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Rotation (deg)", IDC_ROTATION_LABEL, 7, 44, 54, 12
    EDITTEXT IDC_ROT_X, 64, 41, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ROT_Y, 108, 41, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ROT_Z, 152, 41, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Scale", IDC_SCALE_LABEL, 7, 61, 54, 12
    EDITTEXT IDC_SCALE_X, 64, 58, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_Y, 108, 58, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_Z, 152, 58, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Road editor", IDC_ROAD_TITLE, 7, 91, 190, 12
    LTEXT "", IDC_PROPERTY_DETAIL, 7, 111, 185, 12, NOT WS_VISIBLE | SS_PATHELLIPSIS
    PUSHBUTTON "-", IDC_RADIUS_LESS, 7, 128, 22, 16, NOT WS_VISIBLE
    CTEXT "", IDC_RADIUS_VALUE, 33, 131, 49, 12, NOT WS_VISIBLE
    PUSHBUTTON "+", IDC_RADIUS_MORE, 86, 128, 22, 16, NOT WS_VISIBLE
    AUTOCHECKBOX "Stop line", IDC_STOP_LINE, 7, 128, 95, 14, NOT WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX "Invincible", IDC_INVINCIBLE, 7, 128, 95, 14, NOT WS_VISIBLE
    LTEXT "Road names", IDC_ROAD_NAMES_LABEL, 7, 111, 50, 12
    EDITTEXT IDC_ROAD_NAMES, 63, 108, 129, 16, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Paint markings", IDC_PAINT_MARKINGS, 7, 128, 136, 14, WS_TABSTOP
    CONTROL "Pavement material", IDC_ROAD_MATERIAL, "Static", SS_OWNERDRAW | SS_NOTIFY, 7, 149, 185, 36
    PUSHBUTTON "Clear material", IDC_MARKER_CLEAR_MATERIAL, 7, 188, 66, 15, NOT WS_VISIBLE
    LTEXT "Marker text", IDC_MARKER_TEXT_LABEL, 7, 209, 48, 12, NOT WS_VISIBLE
    EDITTEXT IDC_MARKER_TEXT, 7, 221, 185, 16, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    CONTROL "Text color", IDC_MARKER_TEXT_COLOR, "Button", BS_OWNERDRAW | WS_TABSTOP | NOT WS_VISIBLE, 7, 242, 185, 18
    LTEXT "Alignment", IDC_CAPTION_ALIGN, 7, 195, 51, 12
    COMBOBOX IDC_ALIGNMENT, 63, 191, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Lanes", IDC_CAPTION_LANES, 7, 216, 50, 12
    PUSHBUTTON "-", IDC_FEWER, 63, 212, 22, 16
    CTEXT "", IDC_LANE_COUNT, 88, 216, 27, 12
    PUSHBUTTON "+", IDC_MORE, 121, 212, 22, 16
    LTEXT "3-lane layout", IDC_LAYOUT_LABEL, 7, 237, 55, 12
    COMBOBOX IDC_LAYOUT, 63, 233, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_LANE_DETAIL, 7, 237, 136, 12
    LTEXT "Shoulders (5 m each)", IDC_CAPTION_SHOULDERS, 7, 255, 136, 12
    AUTOCHECKBOX "Left", IDC_LEFT, 7, 270, 60, 11
    AUTOCHECKBOX "Right", IDC_RIGHT, 77, 270, 60, 11
    LTEXT "Road edges", IDC_CAPTION_EDGES, 7, 293, 53, 12
    COMBOBOX IDC_EDGE, 63, 289, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX "Divided road", IDC_DIVIDED, 7, 310, 136, 12
    LTEXT "Separation (m)", IDC_CAPTION_GAP, 7, 331, 56, 12
    PUSHBUTTON "-", IDC_GAP_LESS, 65, 327, 20, 16
    CTEXT "", IDC_GAP_VALUE, 87, 331, 36, 12
    PUSHBUTTON "+", IDC_GAP_MORE, 125, 327, 20, 16
    LTEXT "Median", IDC_CAPTION_MEDIAN, 7, 352, 51, 12
    COMBOBOX IDC_MEDIAN, 63, 348, 82, 55, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_WIDTH, 7, 372, 150, 12
    LTEXT "", IDC_POINT, 7, 386, 136, 12
    PUSHBUTTON "Finish road", IDC_FINISH, 7, 386, 66, 16
    PUSHBUTTON "Cancel draft", IDC_CANCEL_DRAFT, 77, 386, 66, 16
END

IDD_OUTLINER DIALOGEX 0, 0, ROAD_PANEL_WIDTH, 140
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Outliner", -1, 7, 7, 44, 12
    PUSHBUTTON "New folder", IDC_FOLDER_NEW, 55, 3, 50, 16
    PUSHBUTTON "Rename", IDC_FOLDER_RENAME, 109, 3, 44, 16
    PUSHBUTTON "Delete", IDC_FOLDER_DELETE, 157, 3, 44, 16
    CONTROL "", IDC_OUTLINE_LIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER, 5, 22, 198, 113
END

IDD_NAME DIALOGEX 0, 0, 183, 56
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Name"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_NAME, 7, 7, 169, 15, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 73, 32, 49, 15
    PUSHBUTTON "Cancel", IDCANCEL, 127, 32, 49, 15
END

IDD_MATERIAL DIALOGEX 0, 0, 390, 245
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "Material Editor"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_MAT_PREVIEW, "Static", SS_OWNERDRAW | SS_NOTIFY, 0, 0, 240, 245
    LTEXT "Material type", IDC_MAT_LABEL, 248, 8, 122, 10
    COMBOBOX IDC_MAT_TYPE, 248, 20, 134, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_MAT_SLOT_FIRST + 0, "Static", SS_OWNERDRAW | SS_NOTIFY, 248, 43, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 0, 361, 51, 23, 15
    CONTROL "", IDC_MAT_SLOT_FIRST + 1, "Static", SS_OWNERDRAW | SS_NOTIFY, 248, 82, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 1, 361, 90, 23, 15
    CONTROL "", IDC_MAT_SLOT_FIRST + 2, "Static", SS_OWNERDRAW | SS_NOTIFY, 248, 121, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 2, 361, 129, 23, 15
    CONTROL "", IDC_MAT_SLOT_FIRST + 3, "Static", SS_OWNERDRAW | SS_NOTIFY, 248, 160, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 3, 361, 168, 23, 15
    CONTROL "", IDC_MAT_SLOT_FIRST + 4, "Static", SS_OWNERDRAW | SS_NOTIFY, 248, 199, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 4, 361, 207, 23, 15
    CONTROL "", IDC_MAT_SLOT_FIRST + 5, "Static", SS_OWNERDRAW | SS_NOTIFY | NOT WS_VISIBLE, 248, 121, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 5, 361, 129, 23, 15, NOT WS_VISIBLE
    CONTROL "Emissive tint", IDC_MAT_TINT, "Button", BS_OWNERDRAW | WS_TABSTOP | NOT WS_VISIBLE, 248, 84, 130, 17
    LTEXT "Translucency 1.00", IDC_MAT_FACTOR_LABEL, 248, 161, 130, 12, NOT WS_VISIBLE
    CONTROL "Translucency multiplier", IDC_MAT_FACTOR, "msctls_trackbar32", WS_TABSTOP | TBS_NOTICKS | NOT WS_VISIBLE, 248, 175, 130, 18
END
