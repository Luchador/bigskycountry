IDD_PROJECT_SETTINGS DIALOGEX 0, 0, 390, 294
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "Project Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Optimization", -1, 10, 10, 140, 12
    LTEXT "Rail and tie render distance (m)", -1, 10, 32, 132, 12
    EDITTEXT IDC_RAIL_DETAIL_DISTANCE, 146, 29, 65, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "View distance (km)", -1, 10, 56, 132, 12
    EDITTEXT IDC_VIEW_DISTANCE, 146, 53, 65, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "4 km", IDC_VIEW_DISTANCE_4, 218, 53, 38, 15
    PUSHBUTTON "8 km", IDC_VIEW_DISTANCE_8, 260, 53, 38, 15
    PUSHBUTTON "16 km", IDC_VIEW_DISTANCE_16, 302, 53, 38, 15
    LTEXT "3D visibility radius in game kilometers (0.1 - 128).", -1, 10, 80, 330, 12
    LTEXT "Applies to the editor and game. Press F3 for visibility statistics.", -1, 10, 95, 335, 12
    LTEXT "Geometry per CPU/GPU cache (MiB)", -1, 10, 122, 155, 12
    EDITTEXT IDC_STREAM_GEOMETRY, 174, 119, 65, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Shared models + textures (MiB)", -1, 10, 146, 155, 12
    EDITTEXT IDC_STREAM_ASSETS, 174, 143, 65, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Streamed collision (MiB)", -1, 10, 170, 155, 12
    EDITTEXT IDC_STREAM_COLLISION, 174, 167, 65, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Shadow distance (km, 0 disables)", -1, 10, 194, 155, 12
    EDITTEXT IDC_SHADOW_DISTANCE, 174, 191, 65, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Nearby collision and active GPU assets stay protected.", -1, 10, 218, 370, 12
    LTEXT "Editor source data and undo are always kept resident.", -1, 10, 233, 370, 12
    LTEXT "Budgets are project defaults; config.ini can override them locally.", -1, 10, 246, 370, 12
    DEFPUSHBUTTON "Apply", IDOK, 174, 258, 65, 16
END

IDD_MESH DIALOGEX 0, 0, 180, 340
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Material slots", IDC_MESH_TITLE, 6, 6, 168, 12
    LTEXT "Drag materials from the content browser", IDC_MESH_HELP, 6, 20, 168, 12, SS_ENDELLIPSIS
    LTEXT "", IDC_MESH_STATS, 6, 34, 168, 12, SS_ENDELLIPSIS
    LTEXT "Preview &LOD", IDC_MESH_LOD_LABEL, 6, 49, 168, 12
    COMBOBOX IDC_MESH_LOD, 6, 62, 168, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_MESH_SLOTS, "ListBox", WS_TABSTOP | WS_BORDER | WS_VSCROLL | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT, 6, 84, 168, 208
    PUSHBUTTON "&Remove Material", IDC_MESH_REMOVE, 6, 298, 168, 17, WS_DISABLED
    LTEXT "", IDC_MESH_STATUS, 6, 320, 168, 14, SS_PATHELLIPSIS
END

IDD_MESH_AO DIALOGEX 0, 0, 338, 242
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "Bake AO"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Bake ambient occlusion into vertex alpha for all LODs.", -1, 10, 10, 318, 12
    LTEXT "&Samples per vertex (16-1024)", -1, 10, 33, 180, 12
    EDITTEXT IDC_AO_SAMPLES, 203, 30, 100, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Occlusion &radius (m)", -1, 10, 57, 180, 12
    EDITTEXT IDC_AO_DISTANCE, 203, 54, 100, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "S&trength (0-4)", -1, 10, 81, 180, 12
    EDITTEXT IDC_AO_STRENGTH, 203, 78, 100, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Surface &bias (m)", -1, 10, 105, 180, 12
    EDITTEXT IDC_AO_BIAS, 203, 102, 100, 15, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Sample both sides of &foliage", IDC_AO_TWOSIDED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 127, 310, 14
    LTEXT "Radius and bias use model meters, before instance scaling.", -1, 10, 146, 318, 12
    DEFPUSHBUTTON "&Bake AO", IDC_AO_BAKE, 10, 167, 74, 18
    PUSHBUTTON "&Clear AO", IDC_AO_CLEAR, 91, 167, 74, 18
    PUSHBUTTON "Cancel Bake", IDC_AO_CANCEL, 172, 167, 74, 18, WS_DISABLED
    PUSHBUTTON "Close", IDCANCEL, 253, 167, 74, 18
    CONTROL "", IDC_AO_PROGRESS, "msctls_progress32", WS_VISIBLE, 10, 192, 318, 10
    LTEXT "", IDC_AO_STATUS, 10, 209, 318, 28
END
