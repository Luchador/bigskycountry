    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 7, 361, 129, 23, 15, NOT WS_VISIBLE
    CONTROL "", IDC_MAT_SLOT_FIRST + 8, "Static", SS_OWNERDRAW | SS_NOTIFY | NOT WS_VISIBLE, 248, 121, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 8, 361, 129, 23, 15, NOT WS_VISIBLE
    CONTROL "", IDC_MAT_SLOT_FIRST + 9, "Static", SS_OWNERDRAW | SS_NOTIFY | NOT WS_VISIBLE, 248, 121, 110, 35
    PUSHBUTTON "Clear", IDC_MAT_CLEAR_FIRST + 9, 361, 129, 23, 15, NOT WS_VISIBLE
    CONTROL "Emissive tint", IDC_MAT_TINT, "Button", BS_OWNERDRAW | WS_TABSTOP | NOT WS_VISIBLE, 248, 84, 130, 17
    LTEXT "Translucency 1.00", IDC_MAT_FACTOR_LABEL, 248, 161, 130, 12, NOT WS_VISIBLE
