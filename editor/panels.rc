#include <windows.h>
#include <commctrl.h>
#include "panel_ids.h"

#ifdef BSC_EMBED_MANIFEST
1 RT_MANIFEST "editor.manifest"
#endif

IDD_TOOLBAR DIALOGEX 0, 0, 300, TOOLBAR_HEIGHT
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Terrain Editor (Ctrl+T)", IDC_TERRAIN_EDITOR, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 3, 1, 21, 23
    RTEXT "1 m", IDC_SNAP_STEP, 0, 7, 34, 12
    CONTROL "Snap off", IDC_SNAP_TO_GRID, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 38, 1, 21, 23
    CONTROL "World space", IDC_TRANSFORM_SPACE, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 0, 1, 21, 23
    LTEXT "Camera speed", IDC_SPEED_LABEL, 4, 7, 54, 12
    CONTROL "", IDC_SPEED, "msctls_trackbar32", WS_TABSTOP | TBS_NOTICKS, 62, 3, 140, 19
    LTEXT "", IDC_SPEED_VALUE, 210, 7, 55, 12
END

IDD_TERRAIN_EDITOR DIALOGEX 0, 0, 260, 240
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "Terrain Editor"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Terrain tools", IDC_TERRAIN_TOOLS, 8, 8, 244, 200
    CONTROL "Raise", IDC_TERRAIN_RAISE, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 16, 24, 32, 32
    CONTROL "Lower", IDC_TERRAIN_LOWER, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 72, 24, 32, 32
    CONTROL "Flatten", IDC_TERRAIN_FLATTEN, "Button", BS_PUSHBUTTON | BS_BITMAP | WS_TABSTOP, 128, 24, 32, 32
    CTEXT "Raise", -1, 12, 58, 40, 12
    CTEXT "Lower", -1, 68, 58, 40, 12
    CTEXT "Flatten", -1, 124, 58, 40, 12
    AUTOCHECKBOX "Enable brush", IDC_TERRAIN_ENABLED, 16, 76, 100, 12, WS_TABSTOP
    LTEXT "Radius (m)", -1, 16, 97, 104, 12
    EDITTEXT IDC_TERRAIN_RADIUS, 140, 94, 90, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Strength", -1, 16, 117, 104, 12
    EDITTEXT IDC_TERRAIN_STRENGTH, 140, 114, 90, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Seam transition (m)", -1, 16, 137, 120, 12
    EDITTEXT IDC_TERRAIN_SEAM, 140, 134, 90, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Hold LMB to sculpt. Ctrl+wheel: radius (0.1-1000 m).\nFlatten samples height at the start of each stroke.\nEsc: cancel stroke / disable brush. Ctrl+Z: undo.", -1, 16, 157, 224, 40
    PUSHBUTTON "Close", IDCANCEL, 198, 216, 54, 16
END

IDD_BROWSER DIALOGEX 0, 0, BROWSER_WIDTH, 240
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Content browser", -1, 7, 8, 79, 14
    PUSHBUTTON "Refresh", IDC_REFRESH, 95, 5, 42, 15
    CONTROL "", IDC_BROWSER_TABS, "SysTabControl32", WS_TABSTOP | TCS_FOCUSONBUTTONDOWN, 7, 24, 130, 21
    CONTROL "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 7, BROWSER_PAGE_TOP, 130, 64
    LTEXT "", IDC_PREVIEW_STATUS, 7, 116, 130, 13
    CONTROL "", IDC_MODELS, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, BROWSER_MODEL_LIST_TOP, 130, 101
    CONTROL "", IDC_TEXTURE_FOLDERS, "SysTreeView32", NOT WS_VISIBLE | WS_TABSTOP | WS_BORDER | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, BROWSER_PAGE_TOP, 130, 64
    LTEXT "", IDC_TEXTURE_STATUS, 7, BROWSER_PAGE_TOP, 130, 13, NOT WS_VISIBLE
    CONTROL "", IDC_TEXTURES, "ListBox", NOT WS_VISIBLE | WS_TABSTOP | WS_BORDER | WS_VSCROLL | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT, 7, BROWSER_PAGE_TOP, 130, 185
END

IDD_ROAD DIALOGEX 0, 0, ROAD_PANEL_WIDTH, ROAD_PANEL_HEIGHT
STYLE DS_CONTROL | DS_SHELLFONT | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX "Use Geographic Coordinates", IDC_USE_GEOGRAPHIC, 7, 1, 186, 12, WS_TABSTOP
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 7, 81, 191, 1
    CTEXT "X", IDC_AXIS_X, 64, 14, 41, 9
    CTEXT "Y", IDC_AXIS_Y, 108, 14, 41, 9
    CTEXT "Z", IDC_AXIS_Z, 152, 14, 41, 9
    LTEXT "Latitude, longitude", IDC_COORDINATES_LABEL, 7, 14, 124, 9, NOT WS_VISIBLE
    LTEXT "Elevation (m)", IDC_ELEVATION_LABEL, 138, 14, 55, 9, NOT WS_VISIBLE
    EDITTEXT IDC_GEO_LOCATION, 7, 24, 126, 14, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT "Location (m)", IDC_POSITION_LABEL, 7, 27, 54, 12
    EDITTEXT IDC_LOC_X, 64, 24, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_LOC_Y, 108, 24, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_LOC_Z, 152, 24, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Rotation (deg)", IDC_ROTATION_LABEL, 7, 44, 54, 12
    EDITTEXT IDC_ROT_X, 64, 41, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ROT_Y, 108, 41, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ROT_Z, 152, 41, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Scale", IDC_SCALE_LABEL, 7, 61, 54, 12
    EDITTEXT IDC_SCALE_X, 64, 58, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_Y, 108, 58, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_Z, 152, 58, 41, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Road editor", IDC_ROAD_TITLE, 7, 91, 190, 12
    LTEXT "", IDC_PROPERTY_DETAIL, 7, 111, 185, 12, NOT WS_VISIBLE | SS_PATHELLIPSIS
    PUSHBUTTON "Edit Shoreline", IDC_LAKE_EDIT, 7, 128, 185, 16, NOT WS_VISIBLE | WS_TABSTOP
    PUSHBUTTON "Finish Editing", IDC_LAKE_FINISH, 7, 128, 120, 16, NOT WS_VISIBLE | WS_TABSTOP
    PUSHBUTTON "Cancel", IDC_LAKE_CANCEL, 133, 128, 59, 16, NOT WS_VISIBLE | WS_TABSTOP
    LTEXT "Enter: finish | Esc: cancel", IDC_LAKE_HINT, 7, 192, 185, 38, NOT WS_VISIBLE
    PUSHBUTTON "-", IDC_RADIUS_LESS, 7, 128, 22, 16, NOT WS_VISIBLE
    CTEXT "", IDC_RADIUS_VALUE, 33, 131, 49, 12, NOT WS_VISIBLE
    PUSHBUTTON "+", IDC_RADIUS_MORE, 86, 128, 22, 16, NOT WS_VISIBLE
    LTEXT "Tracks", IDC_TRACKS_LABEL, 7, 111, 68, 12, NOT WS_VISIBLE
    PUSHBUTTON "-", IDC_TRACKS_LESS, 79, 108, 21, 16, NOT WS_VISIBLE
    CTEXT "", IDC_TRACKS_VALUE, 102, 111, 40, 12, NOT WS_VISIBLE
    PUSHBUTTON "+", IDC_TRACKS_MORE, 144, 108, 21, 16, NOT WS_VISIBLE
    LTEXT "Base bed width (m)", IDC_BED_WIDTH_LABEL, 7, 131, 68, 12, NOT WS_VISIBLE
    PUSHBUTTON "-", IDC_BED_WIDTH_LESS, 79, 128, 21, 16, NOT WS_VISIBLE
    CTEXT "", IDC_BED_WIDTH_VALUE, 102, 131, 40, 12, NOT WS_VISIBLE
    PUSHBUTTON "+", IDC_BED_WIDTH_MORE, 144, 128, 21, 16, NOT WS_VISIBLE
    LTEXT "Bed height (m)", IDC_BED_HEIGHT_LABEL, 7, 151, 68, 12, NOT WS_VISIBLE
    PUSHBUTTON "-", IDC_BED_HEIGHT_LESS, 79, 148, 21, 16, NOT WS_VISIBLE
    CTEXT "", IDC_BED_HEIGHT_VALUE, 102, 151, 40, 12, NOT WS_VISIBLE
    PUSHBUTTON "+", IDC_BED_HEIGHT_MORE, 144, 148, 21, 16, NOT WS_VISIBLE
    AUTOCHECKBOX "Transition strip", IDC_BED_TRANSITION, 7, 212, 120, 14, NOT WS_VISIBLE | WS_TABSTOP
    LTEXT "Continue paint markings", IDC_INTERSECTION_PAINT_LABEL, 7, 193, 185, 12, NOT WS_VISIBLE
    COMBOBOX IDC_INTERSECTION_PAINT, 7, 207, 185, 74, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL | NOT WS_VISIBLE
    LTEXT "Size: center to anchor (m)", IDC_INTERSECTION_SIZE_LABEL, 7, 193, 185, 12, NOT WS_VISIBLE
    EDITTEXT IDC_INTERSECTION_SIZE, 7, 207, 185, 16, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    COMBOBOX IDC_TOWN_ISLAND, 7, 232, 185, 74, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL | NOT WS_VISIBLE
    LTEXT "Island radius (m)", IDC_TOWN_ISLAND_SIZE_LABEL, 7, 258, 185, 12, NOT WS_VISIBLE
    EDITTEXT IDC_TOWN_ISLAND_SIZE, 7, 272, 185, 16, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT "F: fill central island with terrain", IDC_TOWN_FILL_HINT, 7, 301, 185, 12, NOT WS_VISIBLE
    AUTOCHECKBOX "Central island", IDC_INTERSECTION_ISLAND, 7, 232, 185, 14, NOT WS_VISIBLE | WS_TABSTOP
    LTEXT "F: fill central island with terrain", IDC_INTERSECTION_FILL_HINT, 7, 252, 185, 12, NOT WS_VISIBLE
    AUTOCHECKBOX "Stop line", IDC_STOP_LINE, 7, 128, 95, 14, NOT WS_VISIBLE | WS_TABSTOP
    LTEXT "Traffic control", IDC_TRAFFIC_CONTROL_LABEL, 7, 174, 185, 12, NOT WS_VISIBLE
    COMBOBOX IDC_TRAFFIC_CONTROL, 7, 188, 185, 74, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL | NOT WS_VISIBLE
    AUTOCHECKBOX "Align opposite approaches", IDC_ALIGNED_APPROACHES, 7, 149, 185, 14, NOT WS_VISIBLE | WS_TABSTOP
    AUTOCHECKBOX "Invincible", IDC_INVINCIBLE, 7, 128, 95, 14, NOT WS_VISIBLE
    AUTOCHECKBOX "Has Collision", IDC_HAS_COLLISION, 104, 128, 88, 14, NOT WS_VISIBLE | WS_TABSTOP
    LTEXT "Road names", IDC_ROAD_NAMES_LABEL, 7, 111, 50, 12
    EDITTEXT IDC_ROAD_NAMES, 63, 108, 129, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Paint markings", IDC_PAINT_MARKINGS, "Button", BS_3STATE | WS_TABSTOP, 7, 128, 136, 14
    CONTROL "Pavement material", IDC_ROAD_MATERIAL, "Static", SS_OWNERDRAW | SS_NOTIFY, 7, 149, 185, 36
    PUSHBUTTON "Clear material", IDC_MARKER_CLEAR_MATERIAL, 7, 188, 66, 15, NOT WS_VISIBLE
    LTEXT "Marker text", IDC_MARKER_TEXT_LABEL, 7, 209, 48, 12, NOT WS_VISIBLE
    EDITTEXT IDC_MARKER_TEXT, 7, 221, 185, 16, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    CONTROL "Text color", IDC_MARKER_TEXT_COLOR, "Button", BS_OWNERDRAW | WS_TABSTOP | NOT WS_VISIBLE, 7, 242, 185, 18
    LTEXT "Alignment", IDC_CAPTION_ALIGN, 7, 195, 51, 12
    COMBOBOX IDC_ALIGNMENT, 63, 191, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Lanes", IDC_CAPTION_LANES, 7, 216, 50, 12
    PUSHBUTTON "-", IDC_FEWER, 63, 212, 22, 16
    CTEXT "", IDC_LANE_COUNT, 88, 216, 27, 12
    PUSHBUTTON "+", IDC_MORE, 121, 212, 22, 16
    LTEXT "Extra width (m)", IDC_EXTRA_WIDTH_LABEL, 7, 237, 55, 12, NOT WS_VISIBLE
    PUSHBUTTON "-", IDC_EXTRA_WIDTH_LESS, 65, 233, 20, 16, NOT WS_VISIBLE
    CTEXT "", IDC_EXTRA_WIDTH_VALUE, 87, 237, 36, 12, NOT WS_VISIBLE
    PUSHBUTTON "+", IDC_EXTRA_WIDTH_MORE, 125, 233, 20, 16, NOT WS_VISIBLE
    LTEXT "3-lane layout", IDC_LAYOUT_LABEL, 7, 237, 55, 12
    COMBOBOX IDC_LAYOUT, 63, 233, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_LANE_DETAIL, 7, 237, 136, 12
    LTEXT "Shoulders (5 m each)", IDC_CAPTION_SHOULDERS, 7, 255, 136, 12
    CONTROL "Left", IDC_LEFT, "Button", BS_3STATE | WS_TABSTOP, 7, 270, 60, 11
    CONTROL "Right", IDC_RIGHT, "Button", BS_3STATE | WS_TABSTOP, 77, 270, 60, 11
    LTEXT "Road edges", IDC_CAPTION_EDGES, 7, 293, 53, 12
    COMBOBOX IDC_EDGE, 63, 289, 80, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL "Divided road", IDC_DIVIDED, "Button", BS_3STATE | WS_TABSTOP, 7, 310, 136, 12
    LTEXT "Separation (m)", IDC_CAPTION_GAP, 7, 331, 56, 12
    PUSHBUTTON "-", IDC_GAP_LESS, 65, 327, 20, 16
    CTEXT "", IDC_GAP_VALUE, 87, 331, 36, 12
    PUSHBUTTON "+", IDC_GAP_MORE, 125, 327, 20, 16
    LTEXT "Median", IDC_CAPTION_MEDIAN, 7, 352, 51, 12
    COMBOBOX IDC_MEDIAN, 63, 348, 82, 55, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_WIDTH, 7, 372, 150, 12
    LTEXT "", IDC_POINT, 7, 386, 136, 12
    PUSHBUTTON "Finish road", IDC_FINISH, 7, 386, 66, 16
    PUSHBUTTON "Cancel draft", IDC_CANCEL_DRAFT, 77, 386, 66, 16
    LTEXT "End transition (m)", IDC_DEAD_END_LABEL, 7, ROAD_PANEL_HEIGHT + 4, 88, 12, NOT WS_VISIBLE
    EDITTEXT IDC_DEAD_END_LENGTH, 103, ROAD_PANEL_HEIGHT, 89, 16, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT "0 = no dead end", IDC_DEAD_END_HINT, 7, ROAD_PANEL_HEIGHT + 20, 185, 12, NOT WS_VISIBLE
    CONTROL "Transition strip material", IDC_TRANSITION_MATERIAL, "Static", SS_OWNERDRAW | SS_NOTIFY | NOT WS_VISIBLE, 7, ROAD_PANEL_HEIGHT, 185, 36
END

IDD_OUTLINER DIALOGEX 0, 0, ROAD_PANEL_WIDTH, 140
