cmake_minimum_required(VERSION 3.24)
file(STRINGS "${work}/expected.list" current ENCODING UTF-8)
if(EXISTS "${work}/published.list")
    file(STRINGS "${work}/published.list" previous ENCODING UTF-8)
    set(keys ${current})
    if(CMAKE_HOST_WIN32)
        list(TRANSFORM keys TOLOWER)
    endif()
    foreach(path IN LISTS previous)
        set(key "${path}")
        if(CMAKE_HOST_WIN32)
            string(TOLOWER "${path}" key)
        endif()
        if(NOT key IN_LIST keys)
            file(REMOVE "${root}/${path}")
        endif()
    endforeach()
endif()
configure_file("${work}/expected.list" "${work}/published.list" COPYONLY)

# Retire the previous cooker's cache only after successfully rebuilding its
# contents. An unrecognized file or a DDS without a source stays recoverable.
get_filename_component(build_dir "${root}" DIRECTORY)
set(cache "${build_dir}/texture-cache")
if(EXISTS "${cache}/files.list" AND NOT IS_SYMLINK "${cache}")
    file(STRINGS "${cache}/files.list" old_outputs ENCODING UTF-8)
    set(rebuilt)
    foreach(path IN LISTS current)
        if(path MATCHES "^textures/BC[^/]+/(.+)\\.dds$")
            set(source "${CMAKE_MATCH_1}")
            cmake_path(REPLACE_EXTENSION source LAST_ONLY ".dds" OUTPUT_VARIABLE old_path)
            list(APPEND rebuilt "${old_path}")
        endif()
    endforeach()
    file(GLOB_RECURSE entries LIST_DIRECTORIES false RELATIVE "${cache}" "${cache}/*")
    foreach(entry IN LISTS entries)
        if(IS_SYMLINK "${cache}/${entry}" OR
           (NOT entry STREQUAL "files.list" AND (NOT entry IN_LIST old_outputs OR NOT entry IN_LIST rebuilt)))
            return()
        endif()
    endforeach()
    file(REMOVE_RECURSE "${cache}")
endif()
