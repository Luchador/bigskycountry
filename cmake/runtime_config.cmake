# Seed an editable runtime config, without overwriting the user's preferences.
if(NOT EXISTS "${destination}")
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${source}" "${destination}")
endif()

# Add missing entries only in their own section. Existing values (including
# explicit opt-outs or invalid values), comments, UTF-8 BOM and CRLF are retained.
function(ensure_config_entries target_section)
    set(missing ${ARGN})
    string(TOLOWER "${target_section}" target)
    file(READ "${destination}" contents)
    string(ASCII 239 187 191 bom)
    string(REGEX REPLACE "^${bom}" "" remaining "${contents}")
    set(section "")
    # Do not turn lines into a CMake list: unmatched brackets in a malformed
    # INI section would otherwise join all subsequent lines into one item.
    while(NOT remaining STREQUAL "")
        string(FIND "${remaining}" "\n" end)
        if(end LESS 0)
            set(line "${remaining}")
            set(remaining "")
        else()
            string(SUBSTRING "${remaining}" 0 ${end} line)
            math(EXPR end "${end}+1")
            string(SUBSTRING "${remaining}" ${end} -1 remaining)
        endif()
        string(REGEX REPLACE "[;#].*$" "" line "${line}")
        string(STRIP "${line}" line)
        string(TOLOWER "${line}" line)
        if(line MATCHES "^\\[")
            set(section "")
            if(line MATCHES "^\\[([^]]*)\\]$")
                string(STRIP "${CMAKE_MATCH_1}" section)
            endif()
        elseif(section STREQUAL target AND line MATCHES "^([^=]+)=")
            string(STRIP "${CMAKE_MATCH_1}" key)
            foreach(entry IN LISTS ARGN)
                string(REGEX REPLACE "=.*$" "" entry_key "${entry}")
                string(TOLOWER "${entry_key}" entry_key)
                if(key STREQUAL entry_key)
                    list(REMOVE_ITEM missing "${entry}")
                endif()
            endforeach()
        endif()
    endwhile()
    if(NOT missing)
        return()
    endif()
    set(newline "\n")
    # CMake normalizes CRLF while reading text; consult the bytes to retain it.
    file(READ "${destination}" bytes HEX)
    if(bytes MATCHES "0d0a")
        set(newline "\r\n")
        string(REPLACE "\r\n" "\n" contents "${contents}")
        string(REPLACE "\n" "\r\n" contents "${contents}")
    endif()
    set(additions "")
    if(target STREQUAL "streaming")
        string(APPEND additions "; 0 keeps Project Settings; overrides accept 64..16384 MiB. Restart to apply.${newline}")
    endif()
    foreach(entry IN LISTS missing)
        string(APPEND additions "${entry}${newline}")
    endforeach()
    string(TOLOWER "${contents}" lower)
    string(REGEX MATCH "(^|${bom}|\n)[ \t]*\\[[ \t]*${target}[ \t]*\\][ \t]*([;#][^\r\n]*)?(\r?\n|$)" header "${lower}")
    if(header)
        string(LENGTH "${header}" length)
        if(header MATCHES "\n$")
            # Include the line ending when finding the header: a malformed
            # earlier header can have the same prefix (e.g. [Streaming] junk).
            string(FIND "${lower}" "${header}" offset)
            math(EXPR offset "${offset}+${length}")
        else()
            # A header without a line ending can only match at EOF.
            string(LENGTH "${contents}" offset)
        endif()
        string(SUBSTRING "${contents}" 0 ${offset} before)
        string(SUBSTRING "${contents}" ${offset} -1 after)
        # Insert after the section header, retaining its comment and line ending.
        if(NOT header MATCHES "\n$")
            string(APPEND before "${newline}")
        endif()
        file(WRITE "${destination}" "${before}${additions}${after}")
    else()
        file(APPEND "${destination}" "${newline}[${target_section}]${newline}${additions}")
    endif()
endfunction()

ensure_config_entries(Graphics "SSAO=1" "SSAOSamples=16" "Bloom=1" "BloomIntensity=0.08" "BloomRadius=1.0" "BloomThreshold=1.0")
ensure_config_entries(Streaming "GeometryMiB=0" "AssetsMiB=0" "CollisionMiB=0")
