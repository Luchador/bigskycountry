# Seed an editable runtime config, without overwriting the user's preferences.
if(NOT EXISTS "${destination}")
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${source}" "${destination}")
endif()

# Upgrade older configs with the newly introduced SSAO controls. Preserve all
# existing values and comments, including explicit opt-outs and invalid values
# the runtime will warn about. Restrict key detection to [Graphics].
file(STRINGS "${destination}" lines ENCODING UTF-8)
set(graphics FALSE)
set(has_ssao FALSE)
set(has_samples FALSE)
foreach(line IN LISTS lines)
    string(REGEX REPLACE "[;#].*$" "" line "${line}")
    string(STRIP "${line}" line)
    string(TOLOWER "${line}" line)
    if(line MATCHES "^\\[([^]]*)\\]$")
        string(STRIP "${CMAKE_MATCH_1}" section)
        if(section STREQUAL "graphics")
            set(graphics TRUE)
        else()
            set(graphics FALSE)
        endif()
    elseif(graphics)
        if(line MATCHES "^ssao[ \t]*=")
            set(has_ssao TRUE)
        elseif(line MATCHES "^ssaosamples[ \t]*=")
            set(has_samples TRUE)
        endif()
    endif()
endforeach()
if(NOT has_ssao OR NOT has_samples)
    file(READ "${destination}" contents)
    set(newline "\n")
    # CMake normalizes CRLF while reading text; consult the bytes to retain it.
    file(READ "${destination}" bytes HEX)
    if(bytes MATCHES "0d0a")
        set(newline "\r\n")
        string(REPLACE "\r\n" "\n" contents "${contents}")
        string(REPLACE "\n" "\r\n" contents "${contents}")
    endif()
    set(additions "")
    if(NOT has_ssao)
        string(APPEND additions "SSAO=1${newline}")
    endif()
    if(NOT has_samples)
        string(APPEND additions "SSAOSamples=16${newline}")
    endif()
    string(TOLOWER "${contents}" lower)
    string(ASCII 239 187 191 bom)
    string(REGEX MATCH "(^|${bom}|\n)[ \t]*\\[[ \t]*graphics[ \t]*\\][^\r\n]*" header "${lower}")
    if(header)
        string(FIND "${lower}" "${header}" offset)
        string(LENGTH "${header}" length)
        math(EXPR offset "${offset}+${length}")
        string(SUBSTRING "${contents}" 0 ${offset} before)
        string(SUBSTRING "${contents}" ${offset} -1 after)
        # Insert after the section header, retaining its comment and line ending.
        if(after MATCHES "^\r?\n")
            string(LENGTH "${CMAKE_MATCH_0}" length)
            string(SUBSTRING "${after}" ${length} -1 after)
        endif()
        file(WRITE "${destination}" "${before}${newline}${additions}${after}")
    else()
        file(APPEND "${destination}" "${newline}[Graphics]${newline}${additions}")
    endif()
endif()
