# Called at configure time, before asset discovery, when upgrading an existing build.
function(bigsky_migrate_assets legacy)
    if(NOT IS_DIRECTORY "${legacy}")
        return()
    endif()
    file(REAL_PATH "${legacy}" old_root)
    file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}/assets" project_root)
    cmake_path(IS_PREFIX old_root "${project_root}" NORMALIZE contains_project)
    if(contains_project OR IS_SYMLINK "${legacy}")
        message(FATAL_ERROR "The legacy build assets resolve to a source directory or symlink: ${legacy}. Use a separate build directory.")
    endif()

    # Empty source folders are useful in the editor. Recover originals that were
    # only in the old build. Never replace a file already in the project.
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${legacy}" "${legacy}/*")
    set(recover)
    set(conflicts)
    set(blocked)
    foreach(entry IN LISTS entries)
        set(old "${legacy}/${entry}")
        set(dest "${project_root}/${entry}")
        cmake_path(GET entry PARENT_PATH parent)
        if(parent IN_LIST blocked)
            list(APPEND blocked "${entry}")
        elseif(IS_SYMLINK "${old}" OR IS_SYMLINK "${dest}")
            list(APPEND conflicts "${entry}")
            list(APPEND blocked "${entry}")
        elseif(entry MATCHES "^(textures|models)(/|$)")
            if(IS_DIRECTORY "${old}")
                if(EXISTS "${dest}" AND NOT IS_DIRECTORY "${dest}")
                    list(APPEND conflicts "${entry}")
                    list(APPEND blocked "${entry}")
                else()
                    file(MAKE_DIRECTORY "${dest}")
                endif()
            elseif(NOT EXISTS "${dest}")
                file(COPY_FILE "${old}" "${dest}")
                list(APPEND recover "${entry}")
            elseif(IS_DIRECTORY "${dest}")
                list(APPEND conflicts "${entry}")
            else()
                file(SHA256 "${old}" original)
                file(SHA256 "${dest}" current)
                if(NOT current STREQUAL original)
                    list(APPEND conflicts "${entry}")
                endif()
            endif()
        elseif(NOT IS_DIRECTORY "${old}")
            # Only discard legacy DDS files that match the old cooker's cache.
            if(entry MATCHES "^cooked/textures/(.+)$")
                set(cache "${CMAKE_CURRENT_BINARY_DIR}/texture-cache/${CMAKE_MATCH_1}")
                if(EXISTS "${cache}" AND NOT IS_DIRECTORY "${cache}")
                    file(SHA256 "${old}" original)
                    file(SHA256 "${cache}" cached)
                    if(original STREQUAL cached)
                        continue()
                    endif()
                endif()
            endif()
            list(APPEND conflicts "${entry}")
        endif()
    endforeach()
    if(recover)
        list(LENGTH recover count)
        message(STATUS "Recovered ${count} build-only files from ${legacy} into ${project_root}")
    endif()
    if(conflicts)
        # Keep only the ambiguous items for review. A retry can finish a
        # partially completed migration without overwriting either version.
        set(backup "${legacy}-backup")
        set(n 1)
        while(EXISTS "${backup}")
            math(EXPR n "${n} + 1")
            set(backup "${legacy}-backup-${n}")
        endwhile()
        foreach(entry IN LISTS conflicts)
            cmake_path(GET entry PARENT_PATH parent)
            file(MAKE_DIRECTORY "${backup}/${parent}")
            file(RENAME "${legacy}/${entry}" "${backup}/${entry}")
        endforeach()
        list(JOIN conflicts "\n  " details)
        message(WARNING "Preserved conflicting or unrecognized files in ${backup}:\n  ${details}")
    endif()
    file(REMOVE_RECURSE "${legacy}")
    message(STATUS "Removed migrated directory ${legacy}")
endfunction()
