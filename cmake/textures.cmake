# Cook a full mip chain per (source, format). Source extensions are part of the
# output key, so sand.tif and sand.png can coexist. All configs share the results.
set(asset_root "${CMAKE_CURRENT_SOURCE_DIR}/assets")
set(cooked_root "${CMAKE_CURRENT_BINARY_DIR}/cooked")
set(asset_work "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/BigSkyAssets.work")
set(texture_root "${asset_root}/textures")
file(GLOB_RECURSE texture_sources CONFIGURE_DEPENDS LIST_DIRECTORIES false RELATIVE "${texture_root}" "${texture_root}/*")
file(GLOB_RECURSE model_sources CONFIGURE_DEPENDS LIST_DIRECTORIES false RELATIVE "${asset_root}/models" "${asset_root}/models/*")
set(BIGSKY_TEXCONV "" CACHE FILEPATH "Optional host DirectXTex texconv executable")
set(texconv "${BIGSKY_TEXCONV}")
set(BIGSKY_HOST_IMAGE_DECODER "" CACHE FILEPATH "Optional native BigSkyDecodeImage for cross-compiling")
set_property(GLOBAL APPEND PROPERTY JOB_POOLS bigsky_texture_jobs=2)
set(cooked_files)
set(texture_jobs)
set(native_image "\\.(tiff?|png|tga|jpe?g|bmp)$")

function(bigsky_stage source destination)
    get_filename_component(directory "${cooked_root}/${destination}" DIRECTORY)
    add_custom_command(OUTPUT "${cooked_root}/${destination}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}"
        COMMAND "${CMAKE_COMMAND}" -E copy "${source}" "${cooked_root}/${destination}"
        DEPENDS "${source}" VERBATIM)
    list(APPEND cooked_files "${destination}")
    set(cooked_files "${cooked_files}" PARENT_SCOPE)
endfunction()

bigsky_stage("${asset_root}/fonts/OpenSans-Semibold.ttf" "fonts/OpenSans-Semibold.ttf")

foreach(model IN LISTS model_sources)
    string(TOLOWER "${model}" lower)
    if(lower MATCHES "\\.glb$")
        bigsky_stage("${asset_root}/models/${model}" "models/${model}")
    endif()
endforeach()

# Resolve material references to the spelling on disk on case-insensitive Windows.
if(CMAKE_HOST_WIN32)
    foreach(source IN LISTS texture_sources)
        string(TOLOWER "${source}" lower)
        string(SHA256 key "${lower}")
        set("source_${key}" "${source}")
    endforeach()
endif()

foreach(source IN LISTS texture_sources)
    string(TOLOWER "${source}" lower)
    if(lower MATCHES "\\.bmat$")
        bigsky_stage("${texture_root}/${source}" "textures/${source}")
        # An edit can add or remove a role-specific cook without renaming any files.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${texture_root}/${source}")
        file(READ "${texture_root}/${source}" material)
        foreach(slot IN ITEMS baseColor normal orm emissive opacity translucency)
            string(JSON map ERROR_VARIABLE missing GET "${material}" textures "${slot}")
            if(NOT missing AND CMAKE_HOST_WIN32)
                string(TOLOWER "${map}" lower_map)
                string(SHA256 key "${lower_map}")
                set(map "${source_${key}}")
            endif()
            if(missing OR NOT map IN_LIST texture_sources)
                continue()
            endif()
            if(slot STREQUAL "normal")
                set(format BC5_UNORM)
            elseif(slot STREQUAL "orm")
                set(format BC7_UNORM)
            elseif(slot STREQUAL "opacity" OR slot STREQUAL "translucency")
                set(format BC4_UNORM)
            else()
                set(format BC7_UNORM_SRGB)
            endif()
            list(APPEND texture_jobs "${format}/${map}")
        endforeach()
    elseif(lower MATCHES "${native_image}")
        cmake_path(GET lower STEM LAST_ONLY stem)
        if(stem MATCHES "_(basecolor|emissive)$" OR lower MATCHES "^world/(sun|moon)\\.tga$")
            set(format BC7_UNORM_SRGB)
        elseif(stem MATCHES "_orm$")
            set(format BC7_UNORM)
        elseif(stem MATCHES "_normal$")
            set(format BC5_UNORM)
        else()
            set(format BC4_UNORM)
        endif()
        list(APPEND texture_jobs "${format}/${source}")
    endif()
endforeach()

if(texture_jobs AND CMAKE_HOST_WIN32 AND NOT texconv)
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
        set(exe texconv_arm64.exe)
        set(hash 4cea9738f92dbadd5955d545edb67aa6ba1e9c3b24f32462bf2e1791cbe713f8)
    else()
        set(exe texconv.exe)
        set(hash dcfdec10244e02cf5037fba089c55fb7e1326b1c8181742d77d15fa5cb5eef06)
    endif()
    FetchContent_Declare(bigsky_texconv
        URL "https://github.com/microsoft/DirectXTex/releases/download/may2026/${exe}"
        URL_HASH "SHA256=${hash}" DOWNLOAD_NO_EXTRACT TRUE DOWNLOAD_NAME "${exe}")
    FetchContent_MakeAvailable(bigsky_texconv)
    set(texconv "${bigsky_texconv_SOURCE_DIR}/${exe}")
elseif(texture_jobs AND NOT texconv)
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" -c "import PIL, numpy, ispc_texcomp" RESULT_VARIABLE missing)
    if(missing)
        message(FATAL_ERROR "Install the host texture tools with: ${Python3_EXECUTABLE} -m pip install -r ${CMAKE_CURRENT_SOURCE_DIR}/tools/texture-requirements.txt")
    endif()
endif()

list(REMOVE_DUPLICATES texture_jobs)
foreach(job IN LISTS texture_jobs)
    string(REGEX MATCH "^([^/]+)/(.+)$" parts "${job}")
    set(format "${CMAKE_MATCH_1}")
    set(source "${CMAKE_MATCH_2}")
    set(original "${texture_root}/${source}")
    set(input "${original}")
    set(tmp "${asset_work}/encode/${job}")
    set(prepare)
    set(decoder)
    string(TOLOWER "${source}" lower)
    if(NOT lower MATCHES "${native_image}")
        # Preserve the browser's wider range of material source formats. The PNG
        # is a temporary encoder input and is removed after this cook succeeds.
        if(BIGSKY_HOST_IMAGE_DECODER)
            set(decoder "${BIGSKY_HOST_IMAGE_DECODER}")
        else()
            if(NOT TARGET BigSkyDecodeImage)
                add_executable(BigSkyDecodeImage EXCLUDE_FROM_ALL tools/decode_image.cpp)
                target_link_libraries(BigSkyDecodeImage PRIVATE BigSkyApplication)
            endif()
            set(decoder BigSkyDecodeImage)
        endif()
        set(input "${tmp}/source.png")
        set(prepare COMMAND ${decoder} "${original}" "${input}")
    endif()
    cmake_path(GET input STEM LAST_ONLY stem)
    if(texconv)
        if(format STREQUAL "BC7_UNORM_SRGB")
            set(flags -srgb)
        elseif(format STREQUAL "BC5_UNORM")
            set(flags --ignore-srgb --swizzle rg)
        elseif(format STREQUAL "BC4_UNORM")
            set(flags --ignore-srgb --swizzle r)
        else()
            set(flags --ignore-srgb)
        endif()
        set(encoder "${texconv}")
        set(command "${encoder}" -nologo -y -dx10 -m 0 -wrap -f "${format}" ${flags} -o "${tmp}" "${input}")
    else()
        set(encoder "${CMAKE_CURRENT_SOURCE_DIR}/tools/cook_texture.py")
        set(command "${Python3_EXECUTABLE}" "${encoder}" "${input}" "${tmp}/${stem}.dds" "${format}")
    endif()
    set(destination "textures/${job}.dds")
    set(output "${cooked_root}/${destination}")
    cmake_path(GET output PARENT_PATH directory)
    add_custom_command(OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${tmp}" "${directory}"
        ${prepare}
        COMMAND ${command}
        COMMAND "${CMAKE_COMMAND}" -E rename "${tmp}/${stem}.dds" "${output}"
        COMMAND "${CMAKE_COMMAND}" -E remove_directory "${tmp}"
        DEPENDS "${original}" ${decoder} "${encoder}" "${CMAKE_CURRENT_LIST_FILE}"
        JOB_POOL bigsky_texture_jobs COMMENT "Cooking ${source} as ${format}" VERBATIM)
    list(APPEND cooked_files "${destination}")
endforeach()

list(JOIN cooked_files "\n" contents)
file(GENERATE OUTPUT "${asset_work}/expected.list" CONTENT "${contents}\n")
set(outputs ${cooked_files})
list(TRANSFORM outputs PREPEND "${cooked_root}/")
add_custom_target(BigSkyTextures DEPENDS ${outputs}
    COMMAND "${CMAKE_COMMAND}" "-Droot=${cooked_root}" "-Dwork=${asset_work}"
            -P "${CMAKE_CURRENT_LIST_DIR}/prune_cooked.cmake" VERBATIM)
