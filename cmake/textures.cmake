# Cook once per source image. Keep editable originals in the browser and stage DDS
# files outside its scan root. All configurations share the same cooked bytes.
set(texture_root "${CMAKE_CURRENT_SOURCE_DIR}/assets/textures")
file(GLOB_RECURSE texture_sources CONFIGURE_DEPENDS LIST_DIRECTORIES false RELATIVE "${texture_root}" "${texture_root}/*")
set(texture_cache "${CMAKE_CURRENT_BINARY_DIR}/texture-cache")
set(BIGSKY_TEXCONV "" CACHE FILEPATH "Optional host DirectXTex texconv executable")
set(texconv "${BIGSKY_TEXCONV}")
# Each encoder may already use the GPU or multiple CPU threads.
set_property(GLOBAL APPEND PROPERTY JOB_POOLS bigsky_texture_jobs=2)
set(texture_outputs)
set(texture_paths)
set(texture_keys)
foreach(source IN LISTS texture_sources)
    string(TOLOWER "${source}" lower)
    if(NOT lower MATCHES "\\.(tiff?|png|tga|jpe?g|bmp)$")
        continue()
    endif()
    cmake_path(GET source STEM LAST_ONLY stem)
    cmake_path(GET source PARENT_PATH parent)
    cmake_path(REPLACE_EXTENSION source LAST_ONLY ".dds" OUTPUT_VARIABLE relative_dds)
    string(TOLOWER "${relative_dds}" key)
    if(key IN_LIST texture_keys)
        message(FATAL_ERROR "Two texture sources produce the same DDS: ${relative_dds}")
    endif()
    list(APPEND texture_keys "${key}")
    string(TOLOWER "${stem}" stem_lower)
    if(stem_lower MATCHES "_(basecolor|emissive)$")
        set(format BC7_UNORM_SRGB)
        set(flags -srgb)
    elseif(stem_lower MATCHES "_orm$")
        set(format BC7_UNORM)
        set(flags --ignore-srgb)
    elseif(stem_lower MATCHES "_normal$")
        set(format BC5_UNORM)
        set(flags --ignore-srgb --swizzle rg)
    else()
        set(format BC4_UNORM)
        set(flags --ignore-srgb --swizzle r)
    endif()

    if(CMAKE_HOST_WIN32 AND NOT texconv)
        if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
            set(exe texconv_arm64.exe)
            set(hash 4cea9738f92dbadd5955d545edb67aa6ba1e9c3b24f32462bf2e1791cbe713f8)
        else()
            set(exe texconv.exe)
            set(hash dcfdec10244e02cf5037fba089c55fb7e1326b1c8181742d77d15fa5cb5eef06)
        endif()
        FetchContent_Declare(bigsky_texconv
            URL "https://github.com/microsoft/DirectXTex/releases/download/may2026/${exe}"
            URL_HASH "SHA256=${hash}" DOWNLOAD_NO_EXTRACT TRUE DOWNLOAD_NAME "${exe}")
        FetchContent_MakeAvailable(bigsky_texconv)
        set(texconv "${bigsky_texconv_SOURCE_DIR}/${exe}")
    endif()
    set(tmp "${texture_cache}/.work/${relative_dds}")
    if(texconv)
        # Write to a private directory before publishing the finished mip chain.
        set(command "${texconv}" -nologo -y -dx10 -m 0 -wrap -f "${format}" ${flags}
                    -o "${tmp}" "${texture_root}/${source}")
        set(encoder "${texconv}")
    else()
        if(NOT texture_python)
            find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
            set(texture_python "${Python3_EXECUTABLE}")
            execute_process(COMMAND "${texture_python}" -c "import PIL, numpy, ispc_texcomp" RESULT_VARIABLE missing)
            if(missing)
                message(FATAL_ERROR "Install the host texture tools with: ${texture_python} -m pip install -r ${CMAKE_CURRENT_SOURCE_DIR}/tools/texture-requirements.txt")
            endif()
        endif()
        set(encoder "${CMAKE_CURRENT_SOURCE_DIR}/tools/cook_texture.py")
        set(command "${texture_python}" "${encoder}" "${texture_root}/${source}" "${tmp}/${stem}.dds" "${format}")
    endif()
    set(output "${texture_cache}/${relative_dds}")
    add_custom_command(OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${tmp}" "${texture_cache}/${parent}"
        COMMAND ${command}
        COMMAND "${CMAKE_COMMAND}" -E rename "${tmp}/${stem}.dds" "${output}"
        DEPENDS "${texture_root}/${source}" "${encoder}" "${CMAKE_CURRENT_LIST_FILE}"
        JOB_POOL bigsky_texture_jobs
        COMMENT "Cooking ${source} as ${format}" VERBATIM)
    list(APPEND texture_outputs "${output}")
    list(APPEND texture_paths "${relative_dds}")
endforeach()
add_custom_target(BigSkyTextures DEPENDS ${texture_outputs})
list(JOIN texture_paths "\n" texture_manifest)
file(GENERATE OUTPUT "${texture_cache}/files.list" CONTENT "${texture_manifest}\n")
